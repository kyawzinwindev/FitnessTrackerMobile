<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CreateActivityFragment">

    <Spinner
        android:id="@+id/activity_type_spinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/date_edit_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ems="10"
        android:focusable="false"
        android:hint="Date (YYYY-MM-DD)"
        android:inputType="none"
        app:layout_constraintEnd_toEndOf="@+id/activity_type_spinner"
        app:layout_constraintStart_toStartOf="@+id/activity_type_spinner"
        app:layout_constraintTop_toBottomOf="@+id/activity_type_spinner" />

    <EditText
        android:id="@+id/time_edit_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ems="10"
        android:focusable="false"
        android:hint="Time (HH:MM:SS)"
        android:inputType="none"
        app:layout_constraintEnd_toEndOf="@+id/date_edit_text"
        app:layout_constraintStart_toStartOf="@+id/date_edit_text"
        app:layout_constraintTop_toBottomOf="@+id/date_edit_text" />

    <EditText
        android:id="@+id/metric1_edit_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ems="10"
        android:hint="Metric 1"
        android:inputType="numberDecimal"
        app:layout_constraintEnd_toEndOf="@+id/time_edit_text"
        app:layout_constraintStart_toStartOf="@+id/time_edit_text"
        app:layout_constraintTop_toBottomOf="@+id/time_edit_text" />

    <EditText
        android:id="@+id/metric2_edit_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ems="10"
        android:hint="Metric 2"
        android:inputType="numberDecimal"
        app:layout_constraintEnd_toEndOf="@+id/metric1_edit_text"
        app:layout_constraintStart_toStartOf="@+id/metric1_edit_text"
        app:layout_constraintTop_toBottomOf="@+id/metric1_edit_text" />

    <EditText
        android:id="@+id/metric3_edit_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ems="10"
        android:hint="Metric 3"
        android:inputType="numberDecimal"
        app:layout_constraintEnd_toEndOf="@+id/metric2_edit_text"
        app:layout_constraintStart_toStartOf="@+id/metric2_edit_text"
        app:layout_constraintTop_toBottomOf="@+id/metric2_edit_text" />

    <Button
        android:id="@+id/create_activity_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Create Activity"
        app:layout_constraintEnd_toEndOf="@+id/metric3_edit_text"
        app:layout_constraintStart_toStartOf="@+id/metric3_edit_text"
        app:layout_constraintTop_toBottomOf="@+id/metric3_edit_text" />

</androidx.constraintlayout.widget.ConstraintLayout>